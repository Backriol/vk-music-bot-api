# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Источник музыки: yandex или vk
MUSIC_SOURCE=yandex
# Токен Яндекс Музыки: python get_yandex_token.py (вход по коду на ya.ru/device)
YANDEX_TOKEN=

# VK API Configuration
VK_TOKEN=your_vk_admin_token_here
# Токен и User-Agent проще всего получить командой: python get_vk_token.py
VK_USER_AGENT=VKAndroidApp/5.52-4543

# MongoDB Configuration
# Оставьте пустым, чтобы использовать временную базу в памяти
MONGO_URL=mongodb://localhost:27017
DB_NAME=music_bot_db

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Telegram Bot (встроенный бот)
# https-адрес фронтенда Mini App (необязательно)
# Какое @имя бота показывать в кнопках и ссылках, если у бота их несколько
BOT_USERNAME=
WEBAPP_URL=
# Запускать бота вместе с API. Для uvicorn --workers > 1 поставьте false и запустите `python -m app.bot`
RUN_BOT=true

# Лимит песен в день (0 — без лимита, бот бесплатный) и подписка Премиум в звёздах
DAILY_SONG_LIMIT=0
PREMIUM_STARS=20
# Ваш Telegram ID (без лимита) и контакт для вопросов об оплате
ADMIN_IDS=
SUPPORT_CONTACT=
